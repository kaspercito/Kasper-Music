# --- Panel web (variables de Heroku: Settings > Config Vars) ---
# Contraseña para entrar al panel (usa 12+ caracteres). Sin ella el panel queda desactivado.
PANEL_PASSWORD=cambia-esta-contrasena-larga
# Solo si publicas el panel en GitHub Pages: el origen EXACTO de tu página (sin ruta ni barra final).
# Ejemplo: https://tuusuario.github.io
PANEL_ORIGIN=
# Opcional: texto extra para firmar las sesiones (cualquier cadena larga).
PANEL_SECRET=

# --- Spotify (opcional) ---
# Sin esto el bot lee playlists/álbumes públicos de Spotify (hasta 100 canciones).
# Con credenciales (https://developer.spotify.com/dashboard) lee listas completas.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Acceso de invitado (opcional): para que tu comunidad use una versión reducida del panel ---
PANEL_GUEST_PASSWORD=
# IDs de los servidores que el invitado puede ver, separados por coma (vacío = todos).
PANEL_GUEST_GUILDS=
# Permisos del invitado: play (buscar y añadir), control (pausa/saltar/volumen),
# queue (quitar/mover/vaciar), filters. Por defecto "play,control".
PANEL_GUEST_PERMS=play,control,queue,filters,voice

# Invitado SIN contraseña: con "true", cualquiera con el enlace entra como invitado.
# Exige PANEL_GUEST_GUILDS (solo esos servidores serán visibles).
PANEL_GUEST_OPEN=false

# Opcional: ID del canal de texto donde el bot publica "Reproduciendo ahora" cuando la música se pide desde el panel.
PANEL_TEXT_CHANNEL=
