# --- Panel web (variables de Heroku: Settings > Config Vars) ---
# Contraseña para entrar al panel (usa 12+ caracteres). Sin ella el panel queda desactivado.
PANEL_PASSWORD=cambia-esta-contrasena-larga
# Solo si publicas el panel en GitHub Pages: el origen EXACTO de tu página (sin ruta ni barra final).
# Ejemplo: https://tuusuario.github.io
PANEL_ORIGIN=
# Opcional: texto extra para firmar las sesiones (cualquier cadena larga).
PANEL_SECRET=

# --- Spotify (opcional) ---
# Sin esto el bot lee playlists/álbumes públicos de Spotify (hasta 100 canciones).
# Con credenciales (https://developer.spotify.com/dashboard) lee listas completas.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
